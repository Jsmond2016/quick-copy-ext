{
  "manifest_version": 3,
  "name": "Quick Copy Ext",
  "description": "快速整理当前页面异常接口信息，并一键复制反馈内容。",
  "action": {
    "default_popup": "src/pages/popup/index.html",
    "default_icon": {
      "32": "icon-32.png"
    }
  },
  "icons": {
    "128": "icon-128.png"
  },
  "options_page": "src/pages/options/index.html",
  "permissions": [
    "activeTab",
    "tabs",
    "webRequest",
    "storage",
    "clipboardWrite"
  ],
  "commands": {
    "quick-copy/capture-screenshot": {
      "suggested_key": {
        "default": "Ctrl+1",
        "mac": "Alt+1"
      },
      "description": "截图并标注当前页面"
    }
  },
  "host_permissions": [
    "<all_urls>"
  ],
  "content_scripts": [
    {
      "matches": [
        "<all_urls>"
      ],
      "js": [
        "src/pages/content/index.ts"
      ],
      "css": [
        "contentStyle.css"
      ],
      "run_at": "document_start"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "page-network-hook.js",
        "contentStyle.css",
        "icon-128.png",
        "icon-32.png"
      ],
      "matches": [
        "<all_urls>"
      ]
    }
  ]
}
